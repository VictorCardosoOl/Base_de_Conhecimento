{
  "name": "sst-faq",
  "description": "Base de Conhecimento de Alta Performance para Saúde e Segurança do Trabalho (PWA)",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev:all": "npm run auth:up && npm run dev",
    "start:all": "npm run auth:up && npm run build && npm run start",
    "stop:all": "npm run auth:stop",
    "auth:up": "docker compose -f ../api/docker-compose.yml up -d --build --wait",
    "auth:stop": "docker compose -f ../api/docker-compose.yml stop",
    "auth:status": "docker compose -f ../api/docker-compose.yml ps",
    "auth:logs": "docker compose -f ../api/docker-compose.yml logs --tail 50 migrate auth-service",
    "catalog": "node scripts/generate-catalog.js",
    "predev": "npm run catalog",
    "dev": "next dev",
    "prebuild": "npm run catalog",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:md": "markdownlint --config .markdownlint.json 'src/content/artigos/**/*.md'",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test:ui": "vitest run src/tests/(articles|navigation|search|shell|sobre|consent)",
    "test:all": "vitest run --include=\"src/**/*.test.{ts,tsx}\""
  },
  "lint-staged": {
    "src/content/artigos/**/*.md": [
      "markdownlint --config .markdownlint.json",
      "prettier --write"
    ],
    "src/**/*.{ts,tsx}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@sentry/react": "^10.74.0",
    "cmdk": "1.1.1",
    "gsap": "^3.15.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.49.0",
    "marked": "^18.1.0",
    "mermaid": "^11.17.2",
    "minisearch": "^7.2.0",
    "next": "^16.3.5",
    "ogl": "^1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "10.4.23",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "gray-matter": "4.0.3",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.0.1",
    "markdownlint-cli": "^0.49.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "4.1.18",
    "typescript": "5.8.2",
    "vite": "^8.3.0",
    "vitest": "5.0.0"
  }
}
