# Copie para .env e ajuste. Nunca versione o .env nem arquivos de chave.
ENVIRONMENT=development
# /docs e /openapi.json: sem valor, ligado em desenvolvimento e desligado em produção.
# OPENAPI_ENABLED=

# PostgreSQL (driver psycopg 3). Em desenvolvimento, use o banco do docker-compose.
# Usada pelo docker-compose (banco local de desenvolvimento).
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA_DEV
DATABASE_URL=postgresql+psycopg://authservice:TROQUE_ESTA_SENHA_DEV@localhost:5432/authservice

# Chave privada Ed25519 (PEM). Gere com: python -m backend.scripts.generate_keys
JWT_PRIVATE_KEY_FILE=keys/jwt_private.pem
# Chaves públicas anteriores, mantidas no JWKS durante uma rotação (opcional).
# JWT_ADDITIONAL_PUBLIC_KEYS_FILE=keys/jwt_previous_public.pem
# Porta publicada pelo docker-compose (a BaseCore e o compose da raiz usam 8010).
AUTH_PORT=8010
# Igual a AUTH_ISSUER da BaseCore.
JWT_ISSUER=http://localhost:8010
JWT_AUDIENCE=knowledge-api

ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=604800
SESSION_MAX_LIFETIME_SECONDS=2592000
# Tolerância para refresh concorrente (várias abas), em segundos. 0 = estrito (ADR-0008).
REFRESH_REUSE_GRACE_SECONDS=10

# Em HTTP local os prefixos __Host-/__Secure- não funcionam (exigem Secure).
COOKIE_SECURE=false
ACCESS_COOKIE_NAME=kb_at
REFRESH_COOKIE_NAME=kb_rt
REFRESH_COOKIE_PATH=/auth

# Origens do frontend (separadas por vírgula). Nunca use *.
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8010
CORS_ALLOWED_ORIGINS=

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_ATTEMPTS=30
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Por conta, independente do IP (ADR-0016): 10 tentativas em 15 min.
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=10
LOGIN_RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=900
# 0 = ignora X-Forwarded-For. Atrás do Next, use >0 SÓ se o proxy de borda sobrescrever
# o X-Forwarded-For; com 0, o limite por IP vira global (ADR-0006/0016).
TRUSTED_PROXY_COUNT=0

# Cadastro público (POST /auth/register): contas nascem sempre como `user` (ADR-0010).
# Desligado por padrão. Atrás do rewrite do Next, todos os cadastros chegam com o IP do
# Next enquanto TRUSTED_PROXY_COUNT=0 (ADR-0006): ajuste o limite de acordo.
PUBLIC_REGISTRATION_ENABLED=true
REGISTER_RATE_LIMIT_IP_ATTEMPTS=30
REGISTER_RATE_LIMIT_WINDOW_SECONDS=600
# Consulta de disponibilidade do usuário no cadastro (GET /auth/username-available), por IP.
USERNAME_CHECK_RATE_LIMIT_ATTEMPTS=60
USERNAME_CHECK_RATE_LIMIT_WINDOW_SECONDS=60

# Endereço público do site (origem do Next): base dos links enviados por email e das URLs
# de retorno do login social ({PUBLIC_APP_URL}/auth/oauth/<provedor>/callback).
PUBLIC_APP_URL=http://localhost:3000

# Recuperação de senha e confirmação de email (ADR-0012).
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_RATE_LIMIT_IP_ATTEMPTS=10
PASSWORD_RESET_RATE_LIMIT_EMAIL_ATTEMPTS=3
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900

# Envio de email: smtp | disabled (memory é só para testes).
# No docker-compose de desenvolvimento, sem nada aqui, os emails vão para o Mailpit
# (http://localhost:8025). Em produção, use o SMTP do provedor (SES, SendGrid, Resend...):
# EMAIL_BACKEND=smtp
# EMAIL_FROM="Base de Conhecimento <nao-responda@seu-dominio.com>"
# SMTP_HOST=smtp.seu-provedor.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Termos de Uso e Política de Privacidade vigentes (ADR-0014). Mesmas versões exibidas
# pela Base de Conhecimento (src/features/legal/documents.ts).
TERMS_VERSION=2026-10-10
PRIVACY_POLICY_VERSION=2026-10-10
# Guarda o IP junto do aceite (prova do consentimento).
CONSENT_RECORD_IP=true

# Login social (ADR-0013). Provedor sem as duas variáveis fica desligado.
# URLs de retorno a cadastrar no provedor:
#   Google: {PUBLIC_APP_URL}/auth/oauth/google/callback
#   GitHub: {PUBLIC_APP_URL}/auth/oauth/github/callback
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# Usuários de teste, um por papel, criados pelo `docker compose up` (serviço migrate).
# SOMENTE DESENVOLVIMENTO: com ENVIRONMENT=production a configuração é rejeitada.
# Senhas conhecidas de propósito, para testar cada nível de acesso. Nunca reutilize.
SEED_DEV_USERS=true
SEED_ADMIN_EMAIL=admin@teste.local
SEED_ADMIN_PASSWORD=teste-local-123
SEED_EDITOR_EMAIL=editor@teste.local
SEED_EDITOR_PASSWORD=editor-local-teste
SEED_USER_EMAIL=user@teste.local
SEED_USER_PASSWORD=user-local-teste
# Usuário e nome (opcionais). Padrão: admin/Administrador, editor/Editor, leitor/Leitor.
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_NAME=Administrador
