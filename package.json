{
  "name": "sst-faq",
  "description": "Base de Conhecimento de Alta Performance para Saúde e Segurança do Trabalho (PWA)",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-catalog.js",
    "dev": "next dev",
    "prebuild": "node scripts/generate-catalog.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "lint-staged": {
    "src/content/artigos/**/*.md": [
      "markdownlint --config .markdownlint.json",
      "prettier --write"
    ],
    "src/**/*.{ts,tsx}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@sentry/react": "^10.74.0",
    "@types/dompurify": "3.2.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "cmdk": "1.1.1",
    "dompurify": "^3.4.15",
    "framer-motion": "13.2.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.45.0",
    "marked": "^18.0.13",
    "mermaid": "^11.17.2",
    "minisearch": "^7.2.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "10.4.23",
    "gray-matter": "4.0.3",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "markdownlint-cli": "^0.49.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "4.1.18",
    "typescript": "5.8.2",
    "vite": "^8.3.0",
    "vitest": "5.0.0"
  }
}
