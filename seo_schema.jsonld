{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://meusite.com.br/#website",
      "url": "https://meusite.com.br/",
      "name": "Base de Conhecimento SST",
      "description": "Guias oficiais, diretrizes e procedimentos consolidados de Saúde e Segurança do Trabalho e eSocial.",
      "publisher": {
        "@id": "https://meusite.com.br/#organization"
      },
      "inLanguage": "pt-BR",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://meusite.com.br/?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://meusite.com.br/#organization",
      "name": "Base de Conhecimento SST",
      "url": "https://meusite.com.br/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://meusite.com.br/icons/icon-512.png",
        "caption": "Logo Oficial da Base de Conhecimento SST"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "technical support",
        "email": "suporte@meusite.com.br",
        "availableLanguage": ["Portuguese"]
      }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://meusite.com.br/#software",
      "name": "Base de Conhecimento SST Portal",
      "operatingSystem": "All",
      "applicationCategory": "BusinessApplication",
      "description": "Portal corporativo de pesquisa, gestão e auditoria de procedimentos de SST, NRs e eventos do eSocial.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "BRL"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://meusite.com.br/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Início",
          "item": "https://meusite.com.br/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Artigos de SST",
          "item": "https://meusite.com.br/#artigos"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Sobre o Projeto",
          "item": "https://meusite.com.br/sobre"
        }
      ]
    }
  ]
}
