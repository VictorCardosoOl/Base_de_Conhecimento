# ── Autenticação administrativa (obrigatório em produção) ─────────────
# Segredo HMAC da sessão (mín. 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# SHA-256 de "email:senha" (email em minúsculas). Gere com:
#   node -e "console.log(require('crypto').createHash('sha256').update('voce@empresa.com:SuaSenhaForte').digest('hex'))"
# Sem esta variável o login é DESATIVADO em produção (em dev usa admin@admin.com / admin).
ADMIN_CREDENTIAL_HASH=

# ── Observabilidade (opcional; só ativa após consentimento LGPD) ─────
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_VERSION=
