# Copie para .env.local (não versionado) e ajuste.
# Nenhuma variável aqui tem prefixo NEXT_PUBLIC_: todas ficam só no servidor.

# AuthService. Sem AUTH_INTERNAL_URL, o proxy /auth/* fica desligado.
AUTH_INTERNAL_URL=http://localhost:8010
# Deve ser igual a JWT_ISSUER e JWT_AUDIENCE do AuthService.
AUTH_ISSUER=http://localhost:8010
AUTH_AUDIENCE=knowledge-api
# Tem de ser IGUAL a ACCESS_COOKIE_NAME do AuthService (divergência = sessão não reconhecida).
# kb_at em HTTP local; __Host-kb_at em produção (exige HTTPS).
AUTH_ACCESS_COOKIE_NAME=kb_at
# Opcional: por padrão, <AUTH_INTERNAL_URL>/.well-known/jwks.json
# AUTH_JWKS_URL=

# Sentry (opcional; só é ativado após consentimento do usuário).
# NEXT_PUBLIC_SENTRY_DSN=
# Versão usada como release no Sentry (ex.: 1.2.0); opcional.
# NEXT_PUBLIC_APP_VERSION=

# E2E (npm run test:e2e) — contas de teste do AuthService; nunca credenciais reais.
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=
# E2E_EDITOR_EMAIL=
# E2E_EDITOR_PASSWORD=
